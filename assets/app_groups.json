{
  "version": 1,
  "_comment": [
    "Curated process groups for Slidr's program actions. A group matches a running",
    "program when its executable name contains one of `match` (case-insensitive,",
    "with a trailing .exe stripped), or its full path contains one of `paths`,",
    "unless the name contains one of `exclude`.",
    "",
    "`paths` is what keeps the list from going stale: anything under a game",
    "library folder counts as a game without being named here. Slidr additionally",
    "discovers installed browsers from the OS at runtime (see src/app_groups.rs),",
    "so a newly installed browser is picked up without editing this file.",
    "",
    "Users can extend every group — or add their own — via app_groups.json in the",
    "Slidr config directory; that file is merged on top of this one."
  ],
  "groups": [
    {
      "id": "browsers",
      "name": "Browsers",
      "icon": 3,
      "match": [
        "chrome",
        "chromium",
        "thorium",
        "msedge",
        "iexplore",
        "firefox",
        "librewolf",
        "waterfox",
        "floorp",
        "zen",
        "mullvad-browser",
        "brave",
        "opera",
        "vivaldi",
        "safari",
        "yandex",
        "ungoogled",
        "midori",
        "epiphany",
        "falkon",
        "qutebrowser",
        "maxthon",
        "whale",
        "ghostbrowser",
        "tor browser",
        "torbrowser",
        "arc.exe",
        "maxthon"
      ],
      "exclude": [
        "crashpad",
        "chromedriver",
        "geckodriver",
        "updater",
        "installer",
        "webview",
        "msedgewebview"
      ]
    },
    {
      "id": "games",
      "name": "Games",
      "icon": 6,
      "paths": [
